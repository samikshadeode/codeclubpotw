char* reversePrefix(char* word, char ch) {

    int a,b;
    char temp;
    int len=strlen(word);

    for(int i=0;i<len;i++)
    {
        if(word[i]==ch)
        {
            for(a=0,b=i;b>a;a++,b--)
            {
                
                    temp=word[a];
                    word[a]=word[b];
                    word[b]=temp;
                
            }
            return word;
            
        }
    }
    return word;
    
}
